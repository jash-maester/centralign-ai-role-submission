# ---- LLM (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models only during the build phase (plans/01-architecture.md §6).
MODEL_ORCHESTRATOR=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free
MODEL_META_REVIEWER=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free
MODEL_WORKER=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
MODEL_VERIFIER=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free
LLM_DAILY_REQUEST_BUDGET=45
LLM_CACHE=on
LLM_LIVE_TESTS=0
# openrouter (live) | scripted (offline fixtures in tests/fixtures/llm) | stub
LLM_BACKEND=openrouter

# ---- Run defaults (overridden by playbook front matter, then per run) -------
REVIEW_AUTO_THRESHOLD=0.80
APPROVAL_AUTO_THRESHOLD=0.90
DETERMINISM=0.8

# ---- CRM (EspoCRM) ----------------------------------------------------------
ESPO_ADMIN_USER=admin
ESPO_ADMIN_PASSWORD=ledger-admin-pw
ESPO_OPERATOR_USER=ledger.operator
ESPO_OPERATOR_PASSWORD=ledger-operator-pw
ESPO_DB_ROOT_PASSWORD=ledger-root-pw
ESPO_DB_PASSWORD=ledger-db-pw
CRM_INTERNAL_URL=http://espocrm
CRM_PUBLIC_URL=http://localhost:8080

# ---- Host ports (change per git worktree to run stacks side by side) --------
ESPO_PORT=8080
MAILPIT_PORT=8025
API_PORT=8000
WEB_PORT=3000
REDIS_PORT=6379

# ---- Parallel stacks (git worktrees) -----------------------------------------
# Give each worktree its own project + image tag + ports so stacks don't collide.
COMPOSE_PROJECT_NAME=centralignai
IMAGE_TAG=dev
